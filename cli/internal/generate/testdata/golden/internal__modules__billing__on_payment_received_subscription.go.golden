package billing

import (
	"context"
	"encoding/json"

	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/broker"
	"github.com/MerseniBilel/warren/errors"
	"github.com/MerseniBilel/warren/inbox"
	"github.com/MerseniBilel/warren/lifecycle"

	"example.com/myapp/internal/modules/billing/application"
)

type paymentReceivedSubscription struct{}

// newPaymentReceivedSubscription wires the handler into the consumer chain and
// starts it as a lifecycle component. It lives beside module.go because it
// is the only file in the feature permitted to see both the broker and the
// application layer.
//
// When the transport adapters ship, this becomes one line in a Register
// method — transport.OnEvent(r, topic, h) — and the pipeline is assembled
// for you.
func newPaymentReceivedSubscription(
	h app.Handler[application.PaymentReceived, application.PaymentReceivedHandled],
	pub broker.Publisher,
	sub broker.Subscriber,
	store inbox.Store,
	lc lifecycle.Lifecycle,
) *paymentReceivedSubscription {
	// This subscription's name, unique in the process. It scopes the
	// deduplication key, which is what lets another feature consume this
	// same topic without one of them suppressing the other.
	const name = "billing.payment_received"
	const topic = "payment.received"

	// Decode the payload into the typed event; a malformed message is
	// INVALID, which dead-letters without retrying.
	handle := func(ctx context.Context, msg broker.Message) error {
		var e application.PaymentReceived
		if err := json.Unmarshal(msg.Payload, &e); err != nil {
			return errors.Invalid("payload", err)
		}
		_, herr := h.Handle(ctx, e)
		return herr
	}

	// The chain: recover, drain, trace, dedupe, dead-letter, require-id,
	// retry, limit.
	pipeline, wait := broker.Pipeline(name, topic, handle, store, pub)

	// The loop's context must not be OnStart's: that one is the boot
	// context, cancelled as soon as boot finishes under Start/Stop.
	ctx, cancel := context.WithCancel(context.Background())
	lc.Append(lifecycle.Hook{
		Name: "billing payment.received consumer",
		// Subscribe returns once the subscription is LIVE, so OnStart
		// returning means this consumer is genuinely listening. Do not wrap
		// it in a goroutine: that reports "started" before the subscription
		// exists, and anything published in the gap is discarded — by a
		// Publish that reports success, so the outbox marks it published.
		OnStart: func(context.Context) error { return sub.Subscribe(ctx, topic, pipeline) },
		OnStop: func(c context.Context) error {
			cancel()
			return wait(c)
		},
	})
	return &paymentReceivedSubscription{}
}
