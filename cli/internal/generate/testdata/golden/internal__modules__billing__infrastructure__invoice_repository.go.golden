package infrastructure

import (
	"context"

	"github.com/MerseniBilel/warren/persistence"

	"example.com/myapp/internal/modules/billing/domain"
)

// InvoiceRepository is the in-process implementation of the domain's
// port. Swapping it for a real driver is a change to this file and the
// module's provider list — nothing in the domain or the application layer
// moves.
type InvoiceRepository struct {
	inner *persistence.MemoryRepository[*domain.Invoice, domain.InvoiceID]
}

// NewInvoiceRepository returns the repository as its PORT, so the
// container resolves it by the type the application layer asks for.
func NewInvoiceRepository(uow *persistence.MemoryUnitOfWork) domain.InvoiceRepository {
	return &InvoiceRepository{
		inner: persistence.NewMemoryRepository[*domain.Invoice, domain.InvoiceID](uow),
	}
}

// FindByID returns the invoice, or an error carrying CodeNotFound.
func (r *InvoiceRepository) FindByID(ctx context.Context, id domain.InvoiceID) (*domain.Invoice, error) {
	return r.inner.FindByID(ctx, id)
}

// Save persists it. The embedded repository calls persistence.Track, which
// is what enlists the aggregate so its events reach the outbox when the
// transaction commits.
func (r *InvoiceRepository) Save(ctx context.Context, invoice *domain.Invoice) error {
	return r.inner.Save(ctx, invoice)
}
