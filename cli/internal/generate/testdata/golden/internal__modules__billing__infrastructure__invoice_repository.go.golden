package infrastructure

import (
	"context"

	"github.com/MerseniBilel/warren/persistence"

	"example.com/myapp/internal/modules/billing/domain"
)

// InvoiceRepository is the in-process implementation of the domain's
// port. Swapping it for a real driver is a change to this file and the
// module's provider list — nothing in the domain or the application layer
// moves.
type InvoiceRepository struct {
	inner *persistence.MemoryRepository[*domain.Invoice, domain.InvoiceID]
}

// NewInvoiceRepository returns the repository as its PORT, so the
// container resolves it by the type the application layer asks for.
func NewInvoiceRepository(uow *persistence.MemoryUnitOfWork) domain.InvoiceRepository {
	return &InvoiceRepository{
		inner: persistence.NewMemoryRepository[*domain.Invoice, domain.InvoiceID](uow),
	}
}

// FindByID returns the invoice, or an error carrying CodeNotFound.
func (r *InvoiceRepository) FindByID(ctx context.Context, id domain.InvoiceID) (*domain.Invoice, error) {
	return r.inner.FindByID(ctx, id)
}

// Save persists it. The embedded repository calls persistence.Track, which
// is what enlists the aggregate so its events reach the outbox when the
// transaction commits.
func (r *InvoiceRepository) Save(ctx context.Context, invoice *domain.Invoice) error {
	return r.inner.Save(ctx, invoice)
}

// Delete removes it, and enlists it. The domain's InvoiceRepository port
// does NOT declare this — most aggregates are never deleted, and generating
// the method onto every port would force one on all of them. It is here
// because the Postgres implementation has it too, so the two drivers offer the
// same surface and swapping one for the other is a change to the provider list
// alone.
//
// To use it, add `Delete(ctx context.Context, invoice *Invoice) error` to
// the port in the domain.
//
// It takes the AGGREGATE, not an identifier, because deleting an aggregate is
// exactly when InvoiceCancelled or InvoiceClosed is raised — and those
// events live on the object you are holding. Loading the invoice in here
// instead would not help: that would be a different object with no pending
// events, and enlisting it would publish nothing.
//
//	invoice.Cancel()                    // raises the fact
//	return r.repo.Delete(ctx, invoice)  // the row goes, the fact is published
//
// The embedded repository calls persistence.Track, as it does in Save. The
// Postgres implementation of this method calls persistence.Write instead,
// because there the write is yours to make.
func (r *InvoiceRepository) Delete(ctx context.Context, invoice *domain.Invoice) error {
	return r.inner.Delete(ctx, invoice)
}
