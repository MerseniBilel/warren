package application_test

import (
	"context"
	"testing"

	"example.com/myapp/internal/modules/billing/application"
)

// voidInvoiceUoW runs the function without a transaction and counts the
// times it was asked to — enough to unit-test the handler in isolation. A
// hand-written double, no mocking framework: a fake you can read is a fake
// you can trust.
type voidInvoiceUoW struct{ calls int }

func (u *voidInvoiceUoW) Do(ctx context.Context, fn func(context.Context) error) error {
	u.calls++
	return fn(ctx)
}

func TestVoidInvoice(t *testing.T) {
	t.Parallel()

	uow := &voidInvoiceUoW{}
	h := application.NewVoidInvoiceHandler(uow)

	got, err := h.Handle(context.Background(), application.VoidInvoice{
		ID: "void_invoice-1",
	})
	if err != nil {
		t.Fatalf("Handle: %v", err)
	}

	// This one is about the WIRING, and it stays true after you replace the
	// handler's body: app.Transactional is what makes the rows this writes
	// and the outbox rows announcing them commit together or not at all.
	// Take it out of NewVoidInvoiceHandler and this fails.
	if uow.calls != 1 {
		t.Errorf("the handler ran %d transactions, want 1 — is it still wrapped in app.Transactional?", uow.calls)
	}

	// This one is about the STUB, and it is a placeholder: the generated
	// handler echoes its input back, so asserting the echo proves nothing
	// once you write the real thing. Replace it with what the use case
	// actually promises — the aggregate it changed, the event it raised,
	// the invariant it refused to break.
	if got.ID != "void_invoice-1" {
		t.Errorf("got %+v", got)
	}
}
