package infrastructure

import (
	"testing"
	"time"

	"github.com/MerseniBilel/warren/persistence"

	"example.com/myapp/internal/modules/billing/domain"
)

// TestInvoiceRepositoryContract runs the framework's own repository
// contract against this implementation.
//
// It is generated because passing it is not optional and failing to run it is
// invisible. persistence.Write cannot make itself be called: a Save that runs
// its statement directly compiles, vets, serves traffic, answers 201 — and
// loses every event the aggregate raised, with no error, no outbox row and no
// log line. RunContract asserts that Save and Delete ENLIST the aggregate,
// which is the one rule in this package no compiler checks.
//
// Delete it and you are back to a green build over a repository that silently
// drops events. Edit the repository and re-run this first.
//
// It is an in-package test on purpose: NewInvoiceRepository returns the
// domain PORT, and the contract covers the whole Repository surface —
// including the Delete the port does not declare.
func TestInvoiceRepositoryContract(t *testing.T) {
	t.Parallel()
	persistence.RunContract(t, newInvoiceRepositoryForContract, newInvoiceForContract,
		domain.InvoiceID("contract-1"), domain.InvoiceID("contract-2"))
}

// TestInvoiceRepositoryVersionedContract certifies the optimistic lock.
// Invoice embeds domain.VersionedRoot, so every write is conditional on the
// version it was loaded at: two requests that both read version 3 cannot both
// commit, and the loser gets CodeContention — never CodeConflict, which
// app.Retrying does not retry and which a consumer ACKS.
func TestInvoiceRepositoryVersionedContract(t *testing.T) {
	t.Parallel()
	persistence.RunVersionedContract(t, newInvoiceRepositoryForContract, newInvoiceForContract,
		domain.InvoiceID("version-1"), domain.InvoiceID("version-2"),
		domain.InvoiceID("version-3"), domain.InvoiceID("version-4"),
		domain.InvoiceID("version-5"), domain.InvoiceID("version-6"),
		domain.InvoiceID("version-7"))
}

// newInvoiceRepositoryForContract builds a fresh store for one subtest. The
// type assertion is what gives the suite the full Repository surface back
// after the constructor narrowed it to the domain port.
func newInvoiceRepositoryForContract(t *testing.T) (persistence.UnitOfWork, persistence.Repository[*domain.Invoice, domain.InvoiceID]) {
	t.Helper()
	uow := persistence.NewMemoryUnitOfWork()
	return uow, NewInvoiceRepository(uow).(*InvoiceRepository)
}

// newInvoiceForContract builds an invoice with a pending event.
// The pending event is the measurement: the suite asserts it is gone after a
// commit, which is only true if the repository enlisted the aggregate.
func newInvoiceForContract(id domain.InvoiceID) *domain.Invoice {
	return domain.NewInvoice(id, time.Unix(1, 0).UTC())
}
