package application

import (
	"context"
	stderrors "errors"
	"log/slog"
	"time"

	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/errors"
	"github.com/MerseniBilel/warren/log"
)

// PaymentReceived is this module's OWN view of the fact, declared locally and
// decoded from the wire. Add only the fields this feature reads.
//
// It deliberately does not import the publishing module's Go type: the
// contract between modules is the wire format, which is what makes
// extracting a module into its own service a wiring change rather than a
// rewrite.
//
// The keys match what `warren g entity Payment` publishes. If this
// event comes from somewhere else, change the tags to match ITS payload —
// and keep the guard in Handle, which is what turns a mismatch into a
// dead-letter you can read instead of a handler that quietly does nothing.
type PaymentReceived struct {
	PaymentID string    `json:"payment_id"`
	At        time.Time `json:"at"`
}

// PaymentReceivedHandled is the (empty) result — a consumer's response is
// discarded; its error is the disposition.
type PaymentReceivedHandled struct{}

type onPaymentReceived struct{}

// NewOnPaymentReceivedHandler returns the handler for the event. It is an
// app.Handler like any other use case: the subscription is what knows this
// one arrives over a broker.
func NewOnPaymentReceivedHandler() app.Handler[PaymentReceived, PaymentReceivedHandled] {
	return &onPaymentReceived{}
}

func (h *onPaymentReceived) Handle(ctx context.Context, e PaymentReceived) (PaymentReceivedHandled, error) {
	// A payload that carried no identifier is not this event. Decoding is
	// permissive — an unknown shape yields a struct of zero values and no
	// error — so without this check a wire-format mismatch acks for ever and
	// reports nothing anywhere. INVALID dead-letters without retrying, which
	// is right: redelivering the same unreadable payload cannot help.
	//
	// It guards THIS FIELD ONLY. Every field you add above needs its own
	// line here if the handler cannot do its job without it — a field test
	// added a tenant, left the guard alone, and a message missing tenant_id
	// created a tenant-less record that went on to escalate and page an
	// empty address, with no error and no dead letter anywhere.
	if e.PaymentID == "" {
		return PaymentReceivedHandled{}, errors.Invalid("payment_id",
			stderrors.New("the message carried no payment_id, so this payload is not the event this handler decodes from "+"payment.received"))
	}

	// Returning nil acks. Returning an error hands the message to the retry
	// and dead-letter middleware, which decide by the error's code:
	// Unavailable retries, Invalid dead-letters without retrying.
	//
	// InfoContext, not Info: the context is what carries the correlation ID,
	// and it is the ID of the request that published this event.
	log.FromContext(ctx).InfoContext(ctx, "handling payment.received",
		slog.String("payment_id", e.PaymentID))
	return PaymentReceivedHandled{}, nil
}
