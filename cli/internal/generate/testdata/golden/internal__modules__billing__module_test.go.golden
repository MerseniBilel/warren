package billing_test

import (
	"testing"

	warrentest "github.com/MerseniBilel/warren/testing"
	"github.com/MerseniBilel/warren/validate/playground"

	"example.com/myapp/internal/modules/billing"
)

// TestModuleBoots builds the module's whole graph — it and everything it
// imports — and resolves every provider it declares.
//
// It guards the one wiring mistake the compiler cannot: a constructor that
// asks the container for a type no module exports. That is a boot error,
// and without this test the first person to find it is whoever runs the
// service.
func TestModuleBoots(t *testing.T) {
	t.Setenv("MYAPP_NAME", "test")

	// WithValidator is not optional decoration. NewModuleTest compiles the
	// routes itself and never touches App.Validator, so the moment a request
	// in this module carries a tag the standard-library validator cannot
	// enforce — `email`, `min=1`, `gte=1`, `dive` — this test fails while
	// main.go, which installs playground, boots perfectly. It is the same
	// validator main.go binds, named here so the two cannot diverge.
	//
	// This line used to be a COMMENT telling you to add it. A generator that
	// writes one artifact can write the other.
	warrentest.NewModuleTest(t, billing.Module(),
		warrentest.WithMemoryBroker(),
		warrentest.WithValidator(playground.New()))
}
