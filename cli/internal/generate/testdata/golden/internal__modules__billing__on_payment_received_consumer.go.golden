package billing

import (
	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/transport"

	"example.com/myapp/internal/modules/billing/application"
)

// paymentReceivedConsumer registers this feature's subscription to
// payment.received. It is a transport.Controller exactly as an HTTP
// controller is — one Register call, and the framework assembles the consumer
// chain: decode into the typed event, deduplicate through the inbox scoped to
// this subscription, retry, dead-letter.
//
// It lives beside module.go because that is the only place in a feature
// allowed to see both the transport package and the application layer; the
// handler itself is an ordinary use case and imports neither (invariant 5).
type paymentReceivedConsumer struct {
	handle app.Handler[application.PaymentReceived, application.PaymentReceivedHandled]
}

// newPaymentReceivedConsumer is listed in warren.Consumers, so boot step 5 calls
// Register on it exactly once.
func newPaymentReceivedConsumer(
	h app.Handler[application.PaymentReceived, application.PaymentReceivedHandled],
) *paymentReceivedConsumer {
	return &paymentReceivedConsumer{handle: h}
}

// Register subscribes the handler to the topic.
//
// The deduplication key is scoped to THIS subscription, which is what lets
// another feature consume the same topic without one of them suppressing the
// other. A malformed payload is INVALID, which dead-letters without retrying.
func (c *paymentReceivedConsumer) Register(r *transport.Registrar) {
	r.OnEvent("payment.received", c.handle)
}
