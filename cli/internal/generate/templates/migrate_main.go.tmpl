// Command migrate applies this project's SQL migrations.
//
// It is a DEPLOY STEP, run once before the new replicas start — never a
// lifecycle hook. Migrating at boot races every replica of a rolling deploy:
// all but one block past their readiness deadline and get killed, the winner
// applies DDL the still-serving old replicas were not written against, and
// one bad file crash-loops every replica at the same moment. Warren offers
// no option to do it at boot, which is why this binary exists.
package main

import (
	"context"
	"fmt"
	"os"

	"github.com/MerseniBilel/warren/persistence/postgres"

	"{{.Module}}/db/migrations"
)

func main() {
	// The SAME variable internal/platform reads, so the application and its
	// migrations cannot disagree about which database they mean. That comment
	// was here before the code was: this file hardcoded an unprefixed
	// DATABASE_URL while `warren g repository`'s own printed instruction, the
	// contract test it wrote in the same command, and `warren new --db
	// postgres` all used the prefixed form, so the instruction failed against
	// the file it had just written.
	dsn := os.Getenv({{.DSNVar}})
	if dsn == "" {
		fmt.Fprintln(os.Stderr, {{.DSNVar}}+" is not set")
		os.Exit(1)
	}
	ctx := context.Background()

	// Warren's own tables first — warren_outbox and warren_inbox, which the
	// stores verify at boot and your migrations may reference.
	if err := postgres.Migrate(ctx, dsn, postgres.Schema); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println("applied  warren       (warren_outbox, warren_inbox)")

	// Then this project's. Both record into ONE warren_schema_migrations
	// table, keyed by bare filename — so a file of yours named
	// 00001_warren_outbox.sql would be recorded as applied without ever
	// running. Name them for your own aggregates and they cannot collide.
	if err := postgres.Migrate(ctx, dsn, migrations.FS); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
	fmt.Println("applied  db/migrations")
}
