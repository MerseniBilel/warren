package application

import (
	"context"

	"github.com/MerseniBilel/warren/app"
)

// {{.Name}} is the command: the caller's intent, and nothing else. Tag the
// fields that must be present — the transport adapter validates before the
// handler ever runs.
type {{.Name}} struct {
{{.RequestFields}}
}

// {{.Name}}Result is what the caller gets back. Never the aggregate itself:
// a use case returns a view, so the domain can change shape without
// breaking every client.
type {{.Name}}Result struct {
	ID string `json:"id"`
}

type {{.Lower}} struct{}

// New{{.Name}}Handler returns the use case wrapped in its core middleware.
// It returns the PORT, not the concrete type, so the container resolves it
// by the type every adapter and test looks for.
{{if .Read}}//
// No app.Transactional here: this one was generated as a read, and a read
// needs no transaction. Wrapping one costs a real BEGIN and COMMIT per
// request — measured at 22 of them for 20 GETs — for a handler that writes
// nothing. Add it, and the unit of work it takes, if this use case starts
// writing.
func New{{.Name}}Handler() app.Handler[{{.Name}}, {{.Name}}Result] {
	return &{{.Lower}}{}
}{{else}}//
// Transactional wraps the handler in the unit of work, so the rows it
// writes and the outbox rows announcing them commit together or not at all.
func New{{.Name}}Handler(uow app.UnitOfWork) app.Handler[{{.Name}}, {{.Name}}Result] {
	return app.Chain[{{.Name}}, {{.Name}}Result](
		&{{.Lower}}{},
		app.Transactional[{{.Name}}, {{.Name}}Result](uow),
	)
}{{end}}

func (h *{{.Lower}}) Handle(ctx context.Context, cmd {{.Name}}) ({{.Name}}Result, error) {
	// Load the aggregate, call the behaviour that enforces the invariant,
	// save it. Injecting the repository here is the next step: add it to
	// New{{.Name}}Handler's parameters and the container will supply it.
	_ = ctx
	return {{.Name}}Result{ID: cmd.{{.FirstField}}}, nil
}
