package {{.Name}}_test

import (
{{- if .NeedsDSN }}
	"os"
{{- end }}
	"testing"

	warrentest "github.com/MerseniBilel/warren/testing"

	"{{.Module}}/internal/modules/{{.Name}}"
)

// TestModuleBoots builds the module's whole graph — it and everything it
// imports — and resolves every provider it declares.
//
// It guards the one wiring mistake the compiler cannot: a constructor that
// asks the container for a type no module exports. That is a boot error,
// and without this test the first person to find it is whoever runs the
// service.
func TestModuleBoots(t *testing.T) {
	t.Setenv({{.EnvPrefix}}, "test")
{{- if .NeedsDSN }}
	// This module imports platform, which imports the config module, whose
	// DatabaseURL is required. Without a database there is nothing to boot,
	// and a test that fails for want of an environment variable teaches
	// people to ignore red.
	if os.Getenv({{.DSNVar}}) == "" {
		t.Skip({{.DSNVar}} + " is not set; this boot test needs a database")
	}
{{- end }}

	// The moment a request in this module carries a tag the standard-library
	// validator cannot enforce — `email`, `min=1`, `dive` — this boots in
	// production and fails HERE, because NewModuleTest compiles the routes
	// itself and never touches App.Validator. Install the playground module
	// as the boot diagnostic tells you, then add it here too:
	//
	//	warrentest.NewModuleTest(t, {{.Name}}.Module(),
	//		warrentest.WithMemoryBroker(),
	//		warrentest.WithValidator(playground.New()))
	warrentest.NewModuleTest(t, {{.Name}}.Module(), warrentest.WithMemoryBroker())
}
