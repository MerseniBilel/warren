package domain

import (
	"context"
	"time"

	wdomain "github.com/MerseniBilel/warren/domain"
)

// {{.Name}}ID identifies {{.Article}} {{.Lower}}. It is comparable and
// renders itself, which is what domain.ID requires: identifiers become map
// keys, URL segments, and message keys.
type {{.Name}}ID string

func (id {{.Name}}ID) String() string { return string(id) }

// {{.Name}} is the aggregate: the consistency boundary a repository loads
// and saves whole. Add the fields the invariants need, and put every change
// behind a method — a struct whose fields are all exported is a record, not
// an aggregate.
//
// It embeds VersionedRoot, so writes are checked against the version this
// {{.Lower}} was loaded at: two requests that both read version 3 cannot both
// commit, and the loser gets CodeContention instead of silently erasing the
// winner's change — which app.Retrying retries, because re-invoking the
// handler re-reads this aggregate. Swap it for wdomain.AggregateRoot (and drop the version
// column) only if something else already serialises writes to this aggregate.
type {{.Name}} struct {
	wdomain.VersionedRoot[{{.Name}}ID]

	CreatedAt time.Time
}

// New{{.Name}} mints the identity, then raises the fact. Raise records; it
// publishes nothing — the unit of work drains the events into the outbox
// inside the transaction, which is what makes the state change and its
// announcement atomic.
//
// This is the CREATE path only. Loading uses Reconstitute{{.Name}}.
func New{{.Name}}(id {{.Name}}ID, now time.Time) *{{.Name}} {
	x := &{{.Name}}{
		VersionedRoot: wdomain.NewVersionedRoot(id),
		CreatedAt:     now,
	}
	x.Raise({{.Name}}Created{{"{"}}{{.Name}}ID: id, At: now})
	return x
}

// Reconstitute{{.Name}} rebuilds {{.Article}} {{.Lower}} from stored state. It
// is the LOAD path, and it exists for two reasons a repository cannot work
// around:
//
//   - It raises nothing. Loading through New{{.Name}} would re-raise
//     {{.Name}}Created, and the next Save would publish a creation fact for
//     {{.Article}} {{.Lower}} created long ago.
//   - It carries the version. Reconstituting at 0 would make every update
//     look like an insert, and the conflict check would never fire.
func Reconstitute{{.Name}}(id {{.Name}}ID, createdAt time.Time, version int64) *{{.Name}} {
	return &{{.Name}}{
		VersionedRoot: wdomain.ReconstituteVersionedRoot(id, version),
		CreatedAt:     createdAt,
	}
}

// {{.Name}}Created is a fact that has already happened, which is why it is
// named in the past tense and carries no behaviour.
type {{.Name}}Created struct {
	{{.Name}}ID {{.Name}}ID `json:"{{.Snake}}_id"`
	At          time.Time   `json:"at"`
}

// EventName is the topic and the type key for messaging.
func (e {{.Name}}Created) EventName() string { return "{{.Snake}}.created" }

// OccurredAt is when the fact happened, not when it was published.
func (e {{.Name}}Created) OccurredAt() time.Time { return e.At }

// AggregateID ties the fact to its aggregate — and, as the message key,
// preserves per-aggregate order through a partitioned broker.
func (e {{.Name}}Created) AggregateID() string { return e.{{.Name}}ID.String() }

// {{.Name}}Repository is the port the application layer depends on. It
// lives here, in the domain, so infrastructure depends on the domain and
// never the other way round.
//
// Save returns an error carrying errors.CodeContention when the {{.Lower}}
// was changed by someone else since it was loaded. Wrap the handler in
// app.Retrying and it reloads and retries for you; without it, the 409
// reaches the caller.
//
// Your own methods above return errors.Conflict when a RULE refuses — an
// oversell, an illegal transition. Those are never retried, and the
// distinction is the difference between a 409 in 7ms and a 409 in 3s.
type {{.Name}}Repository interface {
	FindByID(ctx context.Context, id {{.Name}}ID) (*{{.Name}}, error)
	Save(ctx context.Context, {{.Lower}} *{{.Name}}) error
}
