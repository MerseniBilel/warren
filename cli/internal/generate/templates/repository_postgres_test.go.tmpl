package infrastructure

import (
	"context"
	"os"
	"testing"
	"time"

	"github.com/MerseniBilel/warren"
	"github.com/MerseniBilel/warren/persistence"
	"github.com/MerseniBilel/warren/persistence/postgres"

	"{{.Module}}/internal/modules/{{.Feature}}/domain"
)

// Test{{.Name}}RepositoryContract runs the framework's own repository
// contract against this implementation, on a real database.
//
// It is generated because passing it is not optional and failing to run it is
// invisible. persistence.Write cannot make itself be called: a Save that runs
// its SQL directly compiles, vets, serves traffic, answers 201 — and loses
// every event the aggregate raised, with no error, no outbox row and no log
// line. RunContract asserts that Save and Delete ENLIST the aggregate, which
// is the one rule in this file no compiler checks.
//
// Delete it and you are back to a green build over a repository that silently
// drops events. Edit the SQL and re-run this first.
//
// It is an in-package test on purpose: New{{.Name}}Repository returns the
// domain PORT, and the contract covers the whole Repository surface —
// including the Delete the port does not declare.
func Test{{.Name}}RepositoryContract(t *testing.T) {
	persistence.RunContract(t, connect{{.Name}}Repository(t), new{{.Name}}ForContract,
		domain.{{.Name}}ID("contract-1"), domain.{{.Name}}ID("contract-2"))
}

// Test{{.Name}}RepositoryVersionedContract certifies the optimistic lock
// against a real server, which is the only place it can be certified: the
// check is `WHERE version = $n` and a rows-affected count, and only a real
// database proves the UPDATE matches nothing once the version has moved.
//
// The loser gets CodeContention — never CodeConflict, which app.Retrying does
// not retry and which a consumer ACKS, destroying the message with its work
// not done.
func Test{{.Name}}RepositoryVersionedContract(t *testing.T) {
	persistence.RunVersionedContract(t, connect{{.Name}}Repository(t), new{{.Name}}ForContract,
		domain.{{.Name}}ID("version-1"), domain.{{.Name}}ID("version-2"),
		domain.{{.Name}}ID("version-3"), domain.{{.Name}}ID("version-4"),
		domain.{{.Name}}ID("version-5"), domain.{{.Name}}ID("version-6"),
		domain.{{.Name}}ID("version-7"))
}

// connect{{.Name}}Repository boots a pool once, applies the migrations, and
// returns the per-subtest factory the suite calls.
//
// It SKIPS when there is no database — and the message says what stopped being
// checked, not merely what is missing, because a skip that reads like an
// environment problem is a skip nobody acts on.
func connect{{.Name}}Repository(t *testing.T) persistence.NewDriver[*domain.{{.Name}}, domain.{{.Name}}ID] {
	t.Helper()

	dsn := os.Getenv({{.DSNVar}})
	if dsn == "" {
		t.Skip({{.DSNVar}} + ` is not set, so the repository contract suite did NOT run.

Nothing has verified that Save and Delete ENLIST the aggregate with the unit
of work — a repository that drops every event it should have published would
be just as green as this run was. Nor has anything verified the optimistic
lock: that a write from a stale version is refused with CodeContention rather
than silently overwriting the winner.

To run it:

    docker run --rm -d -p 5432:5432 -e POSTGRES_PASSWORD=warren postgres:17
    export ` + {{.DSNVar}} + `='postgres://postgres:warren@localhost:5432/postgres?sslmode=disable'
    go test ./...`)
	}

	ctx := context.Background()
	// Warren's own tables first, then yours. Both record into
	// warren_schema_migrations, keyed by bare filename.
	if err := postgres.Migrate(ctx, dsn, postgres.Schema); err != nil {
		t.Fatalf("migrating warren's schema: %v", err)
	}
	if err := postgres.Migrate(ctx, dsn, os.DirFS("../../../../db/migrations")); err != nil {
		t.Fatalf("migrating db/migrations: %v", err)
	}

	// The pool comes from the container, as it does in production — a
	// repository that only ever sees a hand-built handle is not the one the
	// application runs.
	var (
		db  postgres.DB
		uow *postgres.UnitOfWork
	)
	pg := postgres.Module(postgres.DSN(dsn))
	// Named for the AGGREGATE, not the feature: modules are deduplicated by
	// identity, so a second postgres repository in this feature would
	// otherwise declare a module sharing this one's name.
	probe := warren.NewModule("{{.Feature}}_{{.Snake}}_contract",
		warren.Imports(pg),
		warren.Providers(func(d postgres.DB, u *postgres.UnitOfWork) *{{.Lower}}ContractProbe {
			db, uow = d, u
			return &{{.Lower}}ContractProbe{}
		}),
		warren.Eager[*{{.Lower}}ContractProbe](),
	)
	a := warren.New(pg, probe)
	if err := a.Start(ctx); err != nil {
		t.Fatalf("boot: %v", err)
	}
	t.Cleanup(func() { _ = a.Stop(context.Background()) })

	// One fresh store PER SUBTEST, which is what NewDriver promises. RunContract
	// reuses its identities from one subtest to the next; against a shared
	// table a row left behind by an earlier subtest makes the next insert a
	// CONFLICT, and the suite then fails for a reason that has nothing to do
	// with the repository.
	return func(t *testing.T) (persistence.UnitOfWork, persistence.Repository[*domain.{{.Name}}, domain.{{.Name}}ID]) {
		t.Helper()
		if _, err := db(ctx).Exec(ctx, `DELETE FROM {{.Plural}}`); err != nil {
			t.Fatalf("emptying {{.Plural}}: %v", err)
		}
		return uow, &{{.Name}}Repository{db: db}
	}
}

type {{.Lower}}ContractProbe struct{}

// new{{.Name}}ForContract builds {{.Article}} {{.Lower}} with a pending event.
// The pending event is the measurement: the suite asserts it is gone after a
// commit, which is only true if the repository enlisted the aggregate.
func new{{.Name}}ForContract(id domain.{{.Name}}ID) *domain.{{.Name}} {
	return domain.New{{.Name}}(id, time.Unix(1, 0).UTC())
}
