{{if not .Read}}// {{.Lower}}UoW runs the function without a transaction and counts the
// times it was asked to — enough to unit-test the handler in isolation. A
// hand-written double, no mocking framework: a fake you can read is a fake
// you can trust.
type {{.Lower}}UoW struct{ calls int }

func (u *{{.Lower}}UoW) Do(ctx context.Context, fn func(context.Context) error) error {
	u.calls++
	return fn(ctx)
}

{{end}}func Test{{.Name}}(t *testing.T) {
	t.Parallel()

{{if .Read}}	h := application.New{{.Name}}Handler()
{{else}}	uow := &{{.Lower}}UoW{}
	h := application.New{{.Name}}Handler(uow)
{{end}}
	got, err := h.Handle(context.Background(), application.{{.Name}}{
		{{.FirstField}}: "{{.Snake}}-1",
	})
	if err != nil {
		t.Fatalf("Handle: %v", err)
	}

{{if not .Read}}	// This one is about the WIRING, and it stays true after you replace the
	// handler's body: app.Transactional is what makes the rows this writes
	// and the outbox rows announcing them commit together or not at all.
	// Take it out of New{{.Name}}Handler and this fails.
	if uow.calls != 1 {
		t.Errorf("the handler ran %d transactions, want 1 — is it still wrapped in app.Transactional?", uow.calls)
	}

{{end}}	// This one is about the STUB, and it is a placeholder: the generated
	// handler echoes its input back, so asserting the echo proves nothing
