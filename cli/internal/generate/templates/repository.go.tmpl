package infrastructure

import (
	"context"

	"github.com/MerseniBilel/warren/persistence"

	"{{.Module}}/internal/modules/{{.Feature}}/domain"
)

// {{.Name}}Repository is the in-process implementation of the domain's
// port. Swapping it for a real driver is a change to this file and the
// module's provider list — nothing in the domain or the application layer
// moves.
type {{.Name}}Repository struct {
	inner *persistence.MemoryRepository[*domain.{{.Name}}, domain.{{.Name}}ID]
}

// New{{.Name}}Repository returns the repository as its PORT, so the
// container resolves it by the type the application layer asks for.
func New{{.Name}}Repository(uow *persistence.MemoryUnitOfWork) domain.{{.Name}}Repository {
	return &{{.Name}}Repository{
		inner: persistence.NewMemoryRepository[*domain.{{.Name}}, domain.{{.Name}}ID](uow),
	}
}

// FindByID returns the {{.Lower}}, or an error carrying CodeNotFound.
func (r *{{.Name}}Repository) FindByID(ctx context.Context, id domain.{{.Name}}ID) (*domain.{{.Name}}, error) {
	return r.inner.FindByID(ctx, id)
}

// Save persists it. The embedded repository calls persistence.Track, which
// is what enlists the aggregate so its events reach the outbox when the
// transaction commits.
func (r *{{.Name}}Repository) Save(ctx context.Context, {{.Lower}} *domain.{{.Name}}) error {
	return r.inner.Save(ctx, {{.Lower}})
}

// Delete removes it, and enlists it. The domain's {{.Name}}Repository port
// does NOT declare this — most aggregates are never deleted, and generating
// the method onto every port would force one on all of them. It is here
// because the Postgres implementation has it too, so the two drivers offer the
// same surface and swapping one for the other is a change to the provider list
// alone.
//
// To use it, add `Delete(ctx context.Context, {{.Lower}} *{{.Name}}) error` to
// the port in the domain.
//
// It takes the AGGREGATE, not an identifier, because deleting an aggregate is
// exactly when {{.Name}}Cancelled or {{.Name}}Closed is raised — and those
// events live on the object you are holding. Loading the {{.Lower}} in here
// instead would not help: that would be a different object with no pending
// events, and enlisting it would publish nothing.
//
//	{{.Lower}}.Cancel()                    // raises the fact
//	return r.repo.Delete(ctx, {{.Lower}})  // the row goes, the fact is published
//
// The embedded repository calls persistence.Track, as it does in Save. The
// Postgres implementation of this method calls persistence.Write instead,
// because there the write is yours to make.
func (r *{{.Name}}Repository) Delete(ctx context.Context, {{.Lower}} *domain.{{.Name}}) error {
	return r.inner.Delete(ctx, {{.Lower}})
}
