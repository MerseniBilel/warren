package infrastructure

import (
	"context"

	"github.com/MerseniBilel/warren/persistence"

	"{{.Module}}/internal/modules/{{.Feature}}/domain"
)

// {{.Name}}Repository is the in-process implementation of the domain's
// port. Swapping it for a real driver is a change to this file and the
// module's provider list — nothing in the domain or the application layer
// moves.
type {{.Name}}Repository struct {
	inner *persistence.MemoryRepository[*domain.{{.Name}}, domain.{{.Name}}ID]
}

// New{{.Name}}Repository returns the repository as its PORT, so the
// container resolves it by the type the application layer asks for.
func New{{.Name}}Repository(uow *persistence.MemoryUnitOfWork) domain.{{.Name}}Repository {
	return &{{.Name}}Repository{
		inner: persistence.NewMemoryRepository[*domain.{{.Name}}, domain.{{.Name}}ID](uow),
	}
}

// FindByID returns the {{.Lower}}, or an error carrying CodeNotFound.
func (r *{{.Name}}Repository) FindByID(ctx context.Context, id domain.{{.Name}}ID) (*domain.{{.Name}}, error) {
	return r.inner.FindByID(ctx, id)
}

// Save persists it. The embedded repository calls persistence.Track, which
// is what enlists the aggregate so its events reach the outbox when the
// transaction commits.
func (r *{{.Name}}Repository) Save(ctx context.Context, {{.Lower}} *domain.{{.Name}}) error {
	return r.inner.Save(ctx, {{.Lower}})
}
