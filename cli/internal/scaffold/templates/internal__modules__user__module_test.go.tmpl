// TestRegisterUser boots the real graph and drives the use case through it,
// then asserts the event reached the broker — the whole path, with no
// Docker, no network, and no sleeps.
func TestRegisterUser(t *testing.T) {
	t.Setenv("{{.EnvPrefix}}_NAME", "{{.Name}}")

	app := boot(t)

	view, err := warrentest.Invoke[application.RegisterUser, application.UserView](
		context.Background(), app,
		application.RegisterUser{Email: "bob@example.com", Name: "Bob"},
	)
	if err != nil {
		t.Fatalf("Invoke: %v", err)
	}
	if view.Email != "bob@example.com" {
		t.Errorf("view = %+v", view)
	}

	// The outbox relay publishes asynchronously; the message's Key is the
	// aggregate id, which is what preserves per-aggregate order.
	waitFor(t, func() bool {
		return len(warrentest.Published(t, app, "user.registered")) == 1
	}, "the registration event never reached the broker")

	msg := warrentest.Published(t, app, "user.registered")[0]
	if msg.Key != view.ID {
		t.Errorf("message key = %q, want the aggregate id %q", msg.Key, view.ID)
	}
	if msg.Type != "user.registered" {
		t.Errorf("message type = %q", msg.Type)
	}
	_ = broker.Message{}
}

func TestDuplicateEmailIsAConflict(t *testing.T) {
	t.Setenv("{{.EnvPrefix}}_NAME", "{{.Name}}")

	app := boot(t)
	cmd := application.RegisterUser{Email: "bob@example.com", Name: "Bob"}

	if _, err := warrentest.Invoke[application.RegisterUser, application.UserView](context.Background(), app, cmd); err != nil {
		t.Fatalf("first registration: %v", err)
	}
	_, err := warrentest.Invoke[application.RegisterUser, application.UserView](context.Background(), app, cmd)
	if !werrors.Is(err, werrors.CodeConflict) {
		t.Errorf("err = %v, want CONFLICT — an adapter maps it to 409, and a consumer acks it", err)
	}
}

func TestInvalidEmailIsRejected(t *testing.T) {
	t.Setenv("{{.EnvPrefix}}_NAME", "{{.Name}}")

	app := boot(t)
	_, err := warrentest.Invoke[application.RegisterUser, application.UserView](
		context.Background(), app,
		application.RegisterUser{Email: "not-an-address", Name: "Bob"},
	)
	if !werrors.Is(err, werrors.CodeInvalid) {
		t.Errorf("err = %v, want INVALID", err)
	}
	_ = domain.UserID("")
}

{{- if eq .DB "postgres" }}
// boot starts the feature with NO DATABASE, so these tests run on a clean
// checkout with nothing exported and nothing installed.
//
// It boots user.MemoryModule rather than user.Module, and the difference is
// the whole point. user.Module imports the postgres adapter; a driver module
// CONNECTS at boot, deliberately, so a misconfigured service fails its boot
// instead of request 1 — and the pool is Eager, so it dials whether or not
// anything injects it. No substitution can prevent that, because nothing in
// warren removes a module from a graph. So the test graph is one that never
// named postgres.
//
// These tests are about the use case, the aggregate's invariants, the outbox
// and the event reaching the broker — none of which is SQL. The SQL has its
// own test: user_repository_postgres_test.go runs the repository contract
// against a real database and skips without one. That is the ONLY test here
// that needs {{.EnvPrefix}}_DATABASE_URL.
func boot(t *testing.T) *warrentest.App {
	t.Helper()
{{- if eq .Broker "kafka" }}
	// The graph includes the Kafka module, and a driver module CONNECTS at
	// boot — deliberately, so a misconfigured broker fails the boot rather
	// than request 1. WithMemoryBroker below substitutes the ports this test
	// reads, but it cannot stop the client dialling, so these tests need a
	// reachable broker.
	if os.Getenv("{{.EnvPrefix}}_KAFKA_BROKERS") == "" {
		t.Skip("{{.EnvPrefix}}_KAFKA_BROKERS is not set; these tests need a broker")
	}
{{- end }}
	return warrentest.NewModuleTest(t, user.MemoryModule(),
		warrentest.WithMemoryBroker(),
		warrentest.WithMemoryPersistence(),
		// The same validator main.go installs. NewModuleTest compiles the
		// routes itself and never touches App.Validator, so without this the
		// first `email` or `gte=1` tag anyone adds fails HERE while the
		// service boots perfectly.
		warrentest.WithValidator(playground.New()),
	)
}
{{- else }}
// boot starts the feature. Its imports come with it — user imports
// platform, which imports config — so the test names one module and the
// harness swaps in the recording broker.
func boot(t *testing.T) *warrentest.App {
	t.Helper()
{{- if eq .Broker "kafka" }}
	// The graph includes the Kafka module, and a driver module CONNECTS at
	// boot — deliberately, so a misconfigured broker fails the boot rather
	// than request 1. WithMemoryBroker below substitutes the ports this test
	// reads, but it cannot stop the client dialling, so these tests need a
	// reachable broker the same way the ones above need a database.
	if os.Getenv("{{.EnvPrefix}}_KAFKA_BROKERS") == "" {
		t.Skip("{{.EnvPrefix}}_KAFKA_BROKERS is not set; these tests need a broker")
	}
{{- end }}
	return warrentest.NewModuleTest(t, user.Module(),
		warrentest.WithMemoryBroker(),
		// The same validator main.go installs — see the note above.
		warrentest.WithValidator(playground.New()),
	)
}
{{- end }}

// waitFor spins on an observable condition — never a sleep.
func waitFor(t *testing.T, cond func() bool, msg string) {
	t.Helper()
	deadline := time.Now().Add(5 * time.Second)
	for !cond() {
		if time.Now().After(deadline) {
			t.Fatal(msg)
		}
	}
}
