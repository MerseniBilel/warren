// Package config is the application's configuration.
package config

import "time"

// Config is loaded at boot from defaults, then the environment. A missing
// required value fails the boot naming the variable — never a nil-pointer
// panic on the first request.
type Config struct {
	// Name defaults to the name this app was scaffolded under, so the first
	// `go run ./cmd/{{.Name}}` works with no environment set at all.
	//
	// There is deliberately no `validate:"required"` on it: a field with a
	// default can never be unset, so the tag could not fire. Note that
	// setting {{.EnvPrefix}}_NAME to the EMPTY string does override the
	// default with empty — warren/config counts an empty variable as set,
	// because emptiness is a value — so `{{.EnvPrefix}}_NAME=$UNSET_VAR`
	// leaves you a nameless app. Give it a real value per environment.
	Name string `config:"name" default:"{{.Name}}"`

	// Env is the deployment environment.
	Env string `config:"env" default:"development"`
{{- if eq .DB "postgres" }}

	// There is deliberately NO DatabaseURL field here, and the reason is
	// worth knowing before you add one.
	//
	// postgres.Module builds the pool's provider, so its DSN is needed while
	// the module graph is being DECLARED — before this struct exists.
	// internal/platform therefore reads {{.EnvPrefix}}_DATABASE_URL
	// directly, and a field here would be read by nothing.
	//
	// A scaffold once carried one anyway, marked `validate:"required"`, to
	// give the value one documented name. Nothing read it, and being
	// required it failed the boot of every process that did not have a
	// database — a memory dev run, a test binary, a CI job — for a value
	// they were not going to use. A configuration field earns its place by
	// being read.
{{- end }}

	Outbox struct {
		// PollInterval is the relay's safety net; the store signals it
		// directly when a record is appended.
		PollInterval time.Duration `config:"poll_interval" default:"1s"`
		BatchSize    int           `config:"batch_size" default:"100"`
	} `config:"outbox"`
}
