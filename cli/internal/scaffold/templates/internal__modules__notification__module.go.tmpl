// Package notification consumes the events other features raise.
package notification

import (
	"sync"

	"github.com/MerseniBilel/warren"
	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/transport"

	"{{.Module}}/internal/modules/notification/application"
	"{{.Module}}/internal/platform"
)

// Module declares the feature. Declared once — see platform.Module.
var Module = sync.OnceValue(func() warren.Module {
	return warren.NewModule("notification",
{{- if and (eq .DB "postgres") (eq .Broker "kafka") }}
		// Postgres() and Broker() too, because this module injects what
		// those adapters provide — inbox.Store from one, broker.Publisher
		// and broker.Subscriber from the other. Exports name what a module
		// PROVIDES, so platform cannot re-export either on this module's
		// behalf; Warren refuses that at boot and says so.
		warren.Imports(platform.Module(), platform.Postgres(), platform.Broker()),
{{- else if eq .DB "postgres" }}
		// Postgres() too, because the consumer chain injects inbox.Store,
		// which the adapter provides. Exports name what a module PROVIDES,
		// so platform cannot re-export it on this module's behalf.
		warren.Imports(platform.Module(), platform.Postgres()),
{{- else if eq .Broker "kafka" }}
		// Broker() too, because this module injects broker.Publisher and
		// broker.Subscriber, which that adapter module provides. Exports
		// name what a module PROVIDES, so platform cannot re-export them on
		// this module's behalf.
		warren.Imports(platform.Module(), platform.Broker()),
{{- else }}
		warren.Imports(platform.Module()),
{{- end }}
		warren.Providers(application.NewOnUserRegisteredHandler),
		// Consumers, not Eager: this subscription registers through
		// r.OnEvent at boot step 5, and the broker module serves the frozen
		// table. It used to wire its own broker.Pipeline and its own
		// lifecycle hook — 88 lines that are now one line in Register.
		warren.Consumers(NewConsumer),
	)
})

// Consumer registers this feature's subscriptions. It is a
// transport.Controller like an HTTP controller is — one Register call, and
// the framework assembles the consumer chain: decode, dedupe through the
// inbox, retry, dead-letter.
type Consumer struct {
	handle app.Handler[application.UserRegistered, application.Sent]
}

// NewConsumer is listed in warren.Consumers, so boot step 5 calls Register on
// it exactly once.
func NewConsumer(h app.Handler[application.UserRegistered, application.Sent]) *Consumer {
	return &Consumer{handle: h}
}

// Register subscribes the handler to the topic.
//
// This is the whole of it. The pipeline — inbox deduplication scoped to THIS
// subscription, the retry policy, the dead-letter destination — is assembled
// by the broker module from the frozen route table, exactly as the HTTP
// adapter assembles decode/validate/bind for r.Post.
func (c *Consumer) Register(r *transport.Registrar) {
	r.OnEvent("user.registered", c.handle)
}
