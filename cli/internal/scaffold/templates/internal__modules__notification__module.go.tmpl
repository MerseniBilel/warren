// Package notification consumes the events other features raise.
package notification

import (
	"context"
	"encoding/json"
	"sync"

	"github.com/MerseniBilel/warren"
	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/broker"
	"github.com/MerseniBilel/warren/errors"
	"github.com/MerseniBilel/warren/inbox"
	"github.com/MerseniBilel/warren/lifecycle"

	"{{.Module}}/internal/modules/notification/application"
	"{{.Module}}/internal/platform"
)

// Module declares the feature. Declared once — see platform.Module.
var Module = sync.OnceValue(func() warren.Module {
	return warren.NewModule("notification",
{{- if and (eq .DB "postgres") (eq .Broker "kafka") }}
		// Postgres() and Broker() too, because this module injects what
		// those adapters provide — inbox.Store from one, broker.Publisher
		// and broker.Subscriber from the other. Exports name what a module
		// PROVIDES, so platform cannot re-export either on this module's
		// behalf; Warren refuses that at boot and says so.
		warren.Imports(platform.Module(), platform.Postgres(), platform.Broker()),
{{- else if eq .DB "postgres" }}
		// Postgres() too, because the consumer chain injects inbox.Store,
		// which the adapter provides. Exports name what a module PROVIDES,
		// so platform cannot re-export it on this module's behalf.
		warren.Imports(platform.Module(), platform.Postgres()),
{{- else if eq .Broker "kafka" }}
		// Broker() too, because this module injects broker.Publisher and
		// broker.Subscriber, which that adapter module provides. Exports
		// name what a module PROVIDES, so platform cannot re-export them on
		// this module's behalf.
		warren.Imports(platform.Module(), platform.Broker()),
{{- else }}
		warren.Imports(platform.Module()),
{{- end }}
		warren.Providers(application.NewOnUserRegisteredHandler, newSubscription),
		// Eager, not Consumers: this subscription wires its own pipeline and
		// its own lifecycle hook rather than registering through
		// transport.OnEvent, so it is not a transport.Controller. Eager is
		// what builds a type at boot that nothing else depends on.
		warren.Eager[*subscription](),
	)
})

type subscription struct{}

// newSubscription wires the handler into the consumer chain and starts it
// as a lifecycle component.
//
// When the transport adapters ship, this becomes one line in a Register
// method — transport.OnEvent(r, "user.registered", h) — and the pipeline is
// assembled for you.
func newSubscription(
	h app.Handler[application.UserRegistered, application.Sent],
	pub broker.Publisher,
	sub broker.Subscriber,
	store inbox.Store,
	lc lifecycle.Lifecycle,
) *subscription {
	// This subscription's name, unique in the process. It scopes the
	// deduplication key, which is what lets another feature consume this
	// same topic without one of them suppressing the other.
	const name = "notification.user_registered"
	const topic = "user.registered"

	// Decode the payload into the typed event; a malformed message is
	// INVALID, which dead-letters without retrying.
	handle := func(ctx context.Context, msg broker.Message) error {
		var e application.UserRegistered
		if err := json.Unmarshal(msg.Payload, &e); err != nil {
			return errors.Invalid("payload", err)
		}
		_, err := h.Handle(ctx, e)
		return err
	}

	// The chain: recover, drain, trace, dedupe, dead-letter, require-id,
	// retry, limit.
	pipeline, wait := broker.Pipeline(name, topic, handle, store, pub)

	ctx, cancel := context.WithCancel(context.Background())
	lc.Append(lifecycle.Hook{
		Name:    "notification consumer",
		// Subscribe returns once the subscription is LIVE, so OnStart
		// returning means this consumer is genuinely listening. Do not wrap
		// it in a goroutine: that reports "started" before the subscription
		// exists, and anything published in the gap is discarded — by a
		// Publish that reports success, so the outbox marks it published.
		OnStart: func(context.Context) error { return sub.Subscribe(ctx, topic, pipeline) },
		OnStop: func(c context.Context) error {
			cancel()
			return wait(c)
		},
	})
	return &subscription{}
}
