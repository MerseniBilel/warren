// Package infrastructure holds the user feature's driver-facing code.
package infrastructure

import (
	"context"
	"sync"

	"github.com/MerseniBilel/warren/errors"
	"github.com/MerseniBilel/warren/persistence"

	"{{.Module}}/internal/modules/user/domain"
)

// UserRepository is the in-process implementation of the domain's port.
//
// Postgres would do the email lookup with UNIQUE (email); the in-process
// driver has no indexes, so this keeps one. It is deliberately NOT
// transactional — a rolled-back Save leaves the index entry behind — which
// is the honest limit of the memory driver, not a pattern to copy.
type UserRepository struct {
	inner *persistence.MemoryRepository[*domain.User, domain.UserID]

	mu      sync.RWMutex
	byEmail map[domain.Email]domain.UserID
}

// NewUserRepository returns the repository.
func NewUserRepository(uow *persistence.MemoryUnitOfWork) domain.UserRepository {
	return &UserRepository{
		inner:   persistence.NewMemoryRepository[*domain.User, domain.UserID](uow),
		byEmail: map[domain.Email]domain.UserID{},
	}
}

// FindByID returns the user, or an error carrying CodeNotFound.
func (r *UserRepository) FindByID(ctx context.Context, id domain.UserID) (*domain.User, error) {
	return r.inner.FindByID(ctx, id)
}

// FindByEmail returns the user with this address.
func (r *UserRepository) FindByEmail(ctx context.Context, email domain.Email) (*domain.User, error) {
	r.mu.RLock()
	id, ok := r.byEmail[email]
	r.mu.RUnlock()
	if !ok {
		return nil, errors.NotFound("user", email)
	}
	return r.inner.FindByID(ctx, id)
}

// Save persists the user. The embedded repository calls persistence.Track,
// which is what enlists the aggregate so its events reach the outbox when
// the transaction commits.
func (r *UserRepository) Save(ctx context.Context, u *domain.User) error {
	if err := r.inner.Save(ctx, u); err != nil {
		return err
	}
	r.mu.Lock()
	r.byEmail[u.Email] = u.ID()
	r.mu.Unlock()
	return nil
}

// Delete removes the user, and enlists it. The domain's UserRepository port
// does NOT declare this — most aggregates are never deleted, and putting the
// method on every port would force one on all of them. It is here because the
// Postgres implementation has it too, so the two drivers offer the same
// surface and swapping one for the other is a change to the provider list
// alone.
//
// To use it, add `Delete(ctx context.Context, u *User) error` to the port in
// the domain.
//
// It takes the AGGREGATE, not an identifier, because deleting a user is
// exactly when UserClosed or UserDeactivated is raised — and that event lives
// on the object you are holding. Loading the user in here instead would not
// help: that would be a different object with no pending events, and
// enlisting it would publish nothing.
//
//	u.Close()                    // raises the fact
//	return r.repo.Delete(ctx, u) // the row goes, the fact is published
//
// The embedded repository calls persistence.Track, as it does in Save. The
// Postgres implementation of this method calls persistence.Write instead,
// because there the write is yours to make.
func (r *UserRepository) Delete(ctx context.Context, u *domain.User) error {
	if err := r.inner.Delete(ctx, u); err != nil {
		return err
	}
	// The email index is this driver's stand-in for UNIQUE (email); a row
	// removed from the store but left in the index would keep answering
	// FindByEmail with a NOT_FOUND from FindByID.
	r.mu.Lock()
	delete(r.byEmail, u.Email)
	r.mu.Unlock()
	return nil
}
