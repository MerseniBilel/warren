// Package user is the user feature. This file is the only one permitted to
// see all four layers.
package user

import (
	"sync"

	"github.com/MerseniBilel/warren"

	"{{.Module}}/internal/modules/user/application"
	"{{.Module}}/internal/modules/user/domain"
	"{{.Module}}/internal/modules/user/infrastructure"
	"{{.Module}}/internal/platform"
)

// Module declares the feature. Declared once — see platform.Module for why.
var Module = sync.OnceValue(func() warren.Module {
	return warren.NewModule("user",
{{- if eq .DB "postgres" }}
		// Postgres() too, because this feature's repository injects
		// postgres.DB. Exports name what a module PROVIDES, so platform
		// cannot re-export the adapter's ports on its behalf — a feature
		// that needs the database says so.
		warren.Imports(platform.Module(), platform.Postgres()),
{{- else }}
		warren.Imports(platform.Module()),
{{- end }}
		warren.Providers(
			infrastructure.NewUserRepository,
			application.NewRegisterUserHandler,
		),
		// Controllers, not Providers: only Controllers and Consumers are
		// registered at boot step 5, and boot refuses a controller listed as
		// a plain provider rather than let it serve nothing.
		warren.Controllers(NewController),
		// Only this leaves the module. Note what ANOTHER FEATURE needs in
		// order to use it: domain.UserRepository is declared inside this
		// feature, and `warren lint arch` refuses a sibling feature importing
		// that package — so Exports alone does not make it reachable. A port
		// genuinely shared between features moves to internal/contracts/user/
		// first (self-contained, importing no feature), and this line exports
		// THAT type. Within one service, most of what looks like a shared
		// port is really an event.
		warren.Exports[domain.UserRepository](),
	)
})
