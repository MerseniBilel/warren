// Package platform wires the infrastructure every feature module shares:
// the broker, the unit of work, the outbox and its relay.
//
// Swapping an in-process driver for a real one is a change to this file and
// nothing else — which is the point of the ports the rest of the app is
// written against.
package platform

import (
	"context"
	"log/slog"
{{- if eq .Broker "kafka" }}
	"os"
	"strings"
{{- end }}
	"sync"

	"github.com/MerseniBilel/warren"
	"github.com/MerseniBilel/warren/app"
	"github.com/MerseniBilel/warren/broker"
	wconfig "github.com/MerseniBilel/warren/config"
{{- if eq .Broker "kafka" }}
	"github.com/MerseniBilel/warren/broker/kafka"
{{- else }}
	"github.com/MerseniBilel/warren/broker/memory"
{{- end }}
	"github.com/MerseniBilel/warren/inbox"
	"github.com/MerseniBilel/warren/lifecycle"
	"github.com/MerseniBilel/warren/outbox"
	"github.com/MerseniBilel/warren/persistence"

	appconfig "{{.Module}}/internal/config"
)

// ConfigModule loads the application's configuration. It is declared here,
// beside the code that reads it, so every feature module reaches it through
// one import of platform rather than each wiring it themselves.
var ConfigModule = sync.OnceValue(func() warren.Module {
	return wconfig.Module[appconfig.Config](wconfig.WithEnvPrefix("{{.EnvPrefix}}"))
})

{{- if eq .Broker "kafka" }}

// Broker is the messaging adapter, and it is a MODULE rather than a
// constructor — which is why it is declared here and imported, not provided.
//
// Anything that consumes events imports this module DIRECTLY, beside
// platform: a module may export only what its own providers return, so
// platform cannot import this and pass broker.Publisher on to its own
// importers. Warren refuses that at boot and names this shape.
//
// The seed list is read from the environment because kafka.Broker builds its
// providers: its options are needed while the module graph is being DECLARED,
// before the config module's value exists.
var Broker = sync.OnceValue(func() warren.Module {
	return kafka.Broker(
		kafka.Brokers(seeds()...),
		// One group per SERVICE, not per instance: that is what makes
		// partitions divide between replicas instead of every replica
		// reading everything.
		kafka.ConsumerGroup("{{.Name}}"),
		// DEVELOPMENT DEFAULT — remove this before production.
		//
		// Without it the first event this app publishes is REJECTED, because
		// the topic does not exist yet: the outbox parks the row, logs
		// "outbox drain failed", and the event is never delivered. That is
		// the correct production behaviour — an auto-created topic takes the
		// broker's default partition count and replication factor, usually
		// one of each — and it is a poor first run.
		kafka.AutoCreateTopics(),
	)
})

// seeds reads the seed broker list.
//
// An UNSET variable yields no addresses rather than one empty one:
// strings.Split("", ",") is []string{""}, which would send the driver
// dialling "" and reporting a connection failure. With none, kafka.Broker's
// own diagnostic fires instead and names the variable.
func seeds() []string {
	v := strings.TrimSpace(os.Getenv("{{.EnvPrefix}}_KAFKA_BROKERS"))
	if v == "" {
		return nil
	}
	return strings.Split(v, ",")
}
{{- end }}

// Module is declared once: modules are deduplicated by identity, so a plain
// factory called by two importers would be two modules sharing a name — a
// boot error. sync.OnceValue reads like a function and yields one identity.
var Module = sync.OnceValue(func() warren.Module {
	return warren.NewModule("platform",
		warren.Imports(ConfigModule(){{if eq .Broker "kafka"}}, Broker(){{end}}),
		warren.Providers(
{{- if ne .Broker "kafka" }}
			newBroker,
			publisher,
			subscriber,
{{- end }}
			newInbox,
			newOutboxStore,
			newUnitOfWork,
			unitOfWork,
			appUnitOfWork,
			newRelay,
		),
{{- if ne .Broker "kafka" }}
		warren.Exports[broker.Publisher](),
		warren.Exports[broker.Subscriber](),
{{- end }}
		warren.Exports[inbox.Store](),
		warren.Exports[persistence.UnitOfWork](),
		// The concrete unit of work too: the memory repository is built on
		// it, and a real driver would export its own pool the same way.
		warren.Exports[*persistence.MemoryUnitOfWork](),
		warren.Exports[app.UnitOfWork](),
		// Nothing consumes the relay, so without Eager it would never be
		// built — and the outbox would never drain.
		warren.Eager[*outbox.Relay](),
	)
})

{{- if ne .Broker "kafka" }}

// broker returns one in-process broker as both ports. Two constructors would
// build two brokers, and the publisher's messages would never reach the
// subscriber.
type brokerPorts struct {
	pub broker.Publisher
	sub broker.Subscriber
}

func newBroker() brokerPorts {
	b := memory.New()
	return brokerPorts{pub: b, sub: b}
}
{{- end }}

func newInbox() inbox.Store { return inbox.NewMemoryStore() }

func newOutboxStore() outbox.Store { return outbox.NewMemoryStore() }

// newUnitOfWork attaches the outbox to the transaction: the aggregate's new
// state and the rows announcing it commit together or not at all.
func newUnitOfWork(store outbox.Store) *persistence.MemoryUnitOfWork {
	uow := persistence.NewMemoryUnitOfWork()
	uow.OnCommit(outbox.Sink(store, outbox.JSONEncoder()))
	return uow
}

// newRelay drains the outbox to the broker. It registers its own lifecycle
// hook — the documented pattern for anything created at boot, since
// warren.OnStart takes a closure fixed at declaration time.
func newRelay(
	store outbox.Store,
	pub broker.Publisher,
	cfg appconfig.Config,
	lc lifecycle.Lifecycle,
) (*outbox.Relay, error) {
	// It takes the PORT, not platform's own broker value: a test that
	// substitutes a recording publisher must see what the relay publishes.
	relay := outbox.NewRelay(store, pub,
		outbox.PollInterval(cfg.Outbox.PollInterval),
		outbox.BatchSize(cfg.Outbox.BatchSize),
	)

	// The loop's context must not be OnStart's: that one is the boot
	// context, cancelled as soon as boot finishes under Start/Stop.
	ctx, cancel := context.WithCancel(context.Background())
	lc.Append(lifecycle.Hook{
		Name:    "outbox relay",
		OnStart: func(context.Context) error {
			go func() {
				// Reported, not discarded. The relay writes a detailed
				// diagnostic when a record is PARKED — it names the record,
				// the topic, the key and the fact that later records for
				// that key are now out of order — and dropping Run's return
				// here would be the second place that report went nowhere.
				if err := relay.Run(ctx); err != nil {
					slog.Default().Error("outbox relay stopped", "error", err)
				}
			}()
			return nil
		},
		OnStop: func(c context.Context) error {
			cancel()
			return relay.Flush(c)
		},
	})

	// There is deliberately no health.NewCheck("outbox", ...) here. The one
	// that used to be was `func(context.Context) error { return nil }` — it
	// could not fail, and it was registered as CRITICAL, so /readyz named the
	// outbox an up critical dependency while a relay that never drained a
	// single row sat next to it. A check that cannot fail is worse than no
	// check: it turns "we do not monitor this" into "we monitor this and it
	// is fine". Register one here when you have something real to ask.
	return relay, nil
}

{{- if ne .Broker "kafka" }}

// The ports the feature modules actually inject.
//
// The publisher is Correlating: a direct publish then carries the correlation
// ID of the request that made it, so the consumer's log lines belong to the
// same causal chain instead of to no request at all. Events that go through
// the outbox are already stamped at commit by outbox.Sink — the relay
// publishes long after the request is gone — and Correlating leaves a header
// that is already there alone.
func publisher(p brokerPorts) broker.Publisher   { return broker.Correlating(p.pub) }
func subscriber(p brokerPorts) broker.Subscriber { return p.sub }
{{- end }}
func unitOfWork(u *persistence.MemoryUnitOfWork) persistence.UnitOfWork { return u }

// appUnitOfWork is the seam app.Transactional takes: the two interfaces
// differ only in Do's transaction options, which app deliberately does not
// know about.
func appUnitOfWork(u persistence.UnitOfWork) app.UnitOfWork { return persistence.ForApp(u) }
