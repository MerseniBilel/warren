{{- if eq .DB "postgres" }}
.PHONY: run migrate test fmt vet

# A deploy step, run once before the new replicas start — never at boot.
migrate:
	go run ./cmd/migrate

run:
	go run ./cmd/{{.Name}}
{{- else }}
.PHONY: run test fmt vet

run:
	go run ./cmd/{{.Name}}
{{- end }}

test:
	go test -race ./...

fmt:
	gofmt -l -w .

vet:
	go vet ./...
