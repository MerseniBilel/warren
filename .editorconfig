# https://editorconfig.org
# Formatting for Go is owned by gofumpt + gci (see .golangci.yml). This file
# only covers what those tools do not: everything that is not a .go file.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.go]
indent_style = tab
indent_size = 4

[Makefile]
indent_style = tab

[*.{md,markdown}]
# Two trailing spaces is a markdown hard line break; do not strip it.
trim_trailing_whitespace = false

[*.{yml,yaml,json,toml}]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2

# Golden files are byte-exact. No editor may touch them.
[**/testdata/**]
trim_trailing_whitespace = false
insert_final_newline = false
