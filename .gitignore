# Binaries and build output
/bin/
/dist/
*.exe
*.dll
*.so
*.dylib

# Test and coverage artefacts
*.test
*.out
coverage.txt
coverage.html
/.coverage/

# Go workspace files are developer-local. See docs/architecture.md on
# multi-module development: go.work is how you build across modules
# without replace directives, and it must never be committed.
go.work
go.work.sum

# Profiling output
*.prof
*.pprof
cpu.out
mem.out

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Local environment overrides
.env
.env.local
*.local.yaml

# Generated docs site
/site/
/docs/.vitepress/cache/
/docs/.vitepress/dist/

# Scratch space for local experiments (never committed)
/scratch/
/tmp/
