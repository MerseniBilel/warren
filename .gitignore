# go.work is how cross-module development resolves the core module before it
# is tagged. It is generated by `make workspace`, never committed — a
# committed replace or workspace breaks `go get` for users (invariant 8).
go.work
go.work.sum

# Editor and IDE state. Nobody else's window layout belongs in the history,
# and an untracked directory in `git status` trains contributors to ignore it.
.idea/
.vscode/
.DS_Store
