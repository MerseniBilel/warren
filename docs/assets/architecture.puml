' Warren architecture.
'
' Two diagrams live in this file:
'   architecture  — the module map: what we own, what we wrap
'   lifecycle     — what happens between `go run .` and process exit
'
' Regenerate with:
'   java -jar ~/.local/bin/plantuml.jar -tpng -o . architecture.puml

@startuml architecture

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ArrowColor #455A64
skinparam ArrowFontColor #455A64
skinparam roundCorner 8
skinparam nodesep 12
skinparam ranksep 28

skinparam rectangle {
  FontColor #263238
  BackgroundColor<<own>> #C8E6C9
  BorderColor<<own>> #43A047
  BackgroundColor<<wrap>> #FFE0B2
  BorderColor<<wrap>> #FB8C00
  BackgroundColor<<tool>> #E1BEE7
  BorderColor<<tool>> #8E24AA
  StereotypeFontSize 10
  StereotypeFontColor #607D8B
}

skinparam package {
  BorderColor #B0BEC5
  FontColor #37474F
  BackgroundColor #FAFAFA
  FontStyle bold
}

title Warren — module map

legend top right
  |<#C8E6C9>| **We write it** — standard library only |
  |<#FFE0B2>| **We wrap a driver** — named on the box |
  |<#E1BEE7>| **Tooling** — never imported by a running service |
endlegend

package "1 · core module — github.com/MerseniBilel/warren — standard library only, permanently" as core {
  rectangle "**warren**\nNew · Module · Run" <<own>> as root
  rectangle "**di**\ncontainer · scopes · groups · graph" <<own>> as di
  rectangle "**lifecycle**\nordered start · reverse stop" <<own>> as lifecycle
  rectangle "**app**\nHandler[Req,Res] · Middleware" <<own>> as app

  rectangle "**errors**\none type · semantic codes" <<own>> as errors
  rectangle "**log**\nthin layer over log/slog" <<own>> as log
  rectangle "**domain**\nAggregateRoot · Event · Specification" <<own>> as domain
  rectangle "**health**\nreadiness · liveness" <<own>> as health

  root -[hidden]right- di
  di -[hidden]right- lifecycle
  lifecycle -[hidden]right- app
  errors -[hidden]right- log
  log -[hidden]right- domain
  domain -[hidden]right- health
  root -[hidden]down- errors
}

package "2 · cross-cutting — opt-in, still no driver" as cross {
  rectangle "**outbox** · **inbox**\ntransactional delivery · dedupe" <<own>> as outbox
  rectangle "**resilience**\nbreaker · retry · rate limit" <<own>> as resil
  rectangle "**jobs**\ncron · workers" <<own>> as jobs
  rectangle "**auth**\nJWT/OIDC guards · RBAC" <<own>> as auth
  rectangle "**validate**\n**go-playground/validator**" <<wrap>> as validate
  rectangle "**observability**\n**OpenTelemetry**" <<wrap>> as otel

  outbox -[hidden]right- resil
  resil -[hidden]right- jobs
  jobs -[hidden]right- auth
  auth -[hidden]right- validate
  validate -[hidden]right- otel
}

package "3 · ports — define the contract, depend on no driver" as ports {
  rectangle "**transport/http**\nRouter · middleware · status mapping" <<own>> as httpport
  rectangle "**transport/grpc**\ninterceptors · status mapping" <<own>> as grpcport
  rectangle "**broker**\nPublisher · Subscriber · Message" <<own>> as brokerport
  rectangle "**persistence**\nRepository[T,ID] · UnitOfWork" <<own>> as persport
  rectangle "**config**\nLoader port" <<own>> as confport

  httpport -[hidden]right- grpcport
  grpcport -[hidden]right- brokerport
  brokerport -[hidden]right- persport
  persport -[hidden]right- confport
}

package "4 · adapters — one driver each, swappable" as adapters {
  rectangle "http/chi\n**go-chi/chi**" <<wrap>> as chi
  rectangle "http/stdlib\nnet/http" <<own>> as stdmux
  rectangle "http/echo · gin\n**echo** · **gin**" <<wrap>> as echogin
  rectangle "grpc\n**grpc-go**" <<wrap>> as grpcdrv
  rectangle "broker/memory\nin-process" <<own>> as memq

  rectangle "broker/kafka\n**franz-go**" <<wrap>> as kafka
  rectangle "broker/nats · rabbitmq\n**nats.go** · **amqp091**" <<wrap>> as natsmq
  rectangle "persistence/postgres\n**pgx** + **goose**" <<wrap>> as pg
  rectangle "persistence/mysql · mongo · redis" <<wrap>> as otherdb
  rectangle "config/koanf\n**knadh/koanf**" <<wrap>> as koanf

  chi -[hidden]right- stdmux
  stdmux -[hidden]right- echogin
  echogin -[hidden]right- grpcdrv
  grpcdrv -[hidden]right- memq
  kafka -[hidden]right- natsmq
  natsmq -[hidden]right- pg
  pg -[hidden]right- otherdb
  otherdb -[hidden]right- koanf
  chi -[hidden]down- kafka
}

package "5 · tooling — never imported by a running service" as tools {
  rectangle "**cli**\nnew · generate · lint arch · doctor · graph · explain\n**spf13/cobra**" <<tool>> as cli
  rectangle "**mcp**\nread-mostly project resources\n**mcp go-sdk**" <<tool>> as mcp
  rectangle "**openapi**\nOpenAPI 3.1 from handlers" <<tool>> as openapi
  rectangle "**testing**\nmodule harness · fakes\n**testcontainers**" <<tool>> as wtesting

  cli -[hidden]right- mcp
  mcp -[hidden]right- openapi
  openapi -[hidden]right- wtesting
}

' Real dependencies. Every arrow points inward, towards the core.
outbox -up-> domain
resil -up-> app
jobs -up-> lifecycle
auth -up-> app
validate -up-> errors
otel -up-> log

httpport -up-> app : adapts to
grpcport -up-> app
brokerport -up-> app
persport -up-> domain
confport -up-> errors

chi -up-> httpport : implements
stdmux -up-> httpport
echogin -up-> httpport
grpcdrv -up-> grpcport
memq -up-> brokerport
kafka -up-> brokerport
natsmq -up-> brokerport
pg -up-> persport
otherdb -up-> persport
koanf -up-> confport

cli .up.> ports : reads the ports,\ngenerates the wiring
pg -[hidden]down- cli

note left of core
  A minimal service's go.mod
  is **one require line**.
  Nothing in here can pull a
  third-party package into a
  user's build.
end note

note bottom of adapters
  A driver type never reaches a Warren signature — no *chi.Mux, no *pgx.Conn, no *kgo.Client.
  The raw client stays reachable through an explicit escape hatch, because an abstraction
  that cannot be escaped is one users vendor around.
end note

@enduml


@startuml lifecycle

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 12
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityDiamondBackgroundColor #FFF3E0
skinparam ActivityDiamondBorderColor #FB8C00
skinparam NoteBackgroundColor #FFFDE7
skinparam NoteBorderColor #FBC02D

title Warren lifecycle — from `go run .` to exit

start

partition "**boot** — nothing is listening yet" {
  :load configuration;
  note right: files, then env, then flags\nan unknown key is an error, with "did you mean"
  :register modules;
  note right: each module contributes providers,\nroutes, and lifecycle hooks
  :build the DI graph;
  :**validate the graph**;
  note right
    Missing provider, ambiguity, and cycles
    surface **here**, never at first request.
    Nothing is constructed yet.
  end note

  if (graph valid?) then (no)
    :print the resolution chain,
    the requesting file,
    and a copy-pasteable fix; <<#FFCDD2>>
    :exit non-zero;
    stop
  else (yes)
  endif

  :construct singletons in dependency order;
  :bind ports to adapters;
}

partition "**start** — ordered, first to last" {
  :run OnStart hooks in registration order;
  note right: database pool, then broker, then the HTTP\nlistener — a consumer never starts before\nwhat it depends on
  :readiness flips to **ready**;
}

partition "**serving**" {
  fork
    :HTTP requests;
  fork again
    :gRPC calls;
  fork again
    :consumed messages;
  fork again
    :scheduled jobs;
  end fork
  note right
    Every path enters the same
    Handler[Req, Res]. The adapter
    owns status codes, acks, and
    retries. The handler owns none.
  end note
}

partition "**shutdown** — drain first, then reverse order" {
  :SIGTERM / SIGINT;
  :readiness flips to **failing**;
  note right: the load balancer stops routing\nbefore the listener closes
  :stop accepting new work;
  :drain in flight;
  note right: open HTTP requests complete,\nconsumers finish and commit
  :run OnStop hooks in **reverse** order;
  note right: the listener closes before the pool,\nnot after — otherwise in-flight work\nfails at commit
  if (drained inside the grace period?) then (yes)
    :exit 0;
  else (no)
    :force close, log what was abandoned; <<#FFE0B2>>
    :exit non-zero;
  endif
}

stop

@enduml
